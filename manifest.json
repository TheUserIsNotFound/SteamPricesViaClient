{
  "manifest_version": 3,
  "name": "Steam Prices (UAH / RUB / KZT)",
  "version": "2.3.0",
  "description": "Показывает цены в гривнах, рублях и тенге в Steam; переключатели валют; синхронизация вкладок; кэш курсов на 24 часа.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Настройки валют Steam",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
